##################################################################
# https://github.com/github/gitignore/blob/master/Python.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
# *.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

#####################################################

# Various IDEs and Editors
.vscode/
.idea/
**/*~
*.wpr
*.wpu

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# dfx's generated src/declarations/ is retired. The frontend now uses committed,
# didc-generated candid idlFactory bindings in src/frontend/src/canisters/idl/ (which
# ARE committed). This defensive ignore keeps any future @icp-sdk/bindgen output out of git.
**/src/bindings/

# frontend code
node_modules/
dist/
.eslintcache

# secrets & keys
.env
*.pem
secret/

# On the fly data created during deploy
*.wasm

# local & scratch files
x
y
z
README-WIP.md
Makefile-WIP

# llm models for llama_cpp_canister
*.gguf

# If you reinitialize the git repo, outcomment this line during initial commit
src/frontend/assets/deploy-info/commit.json

# dfx deps
deps




# mops build cache (icp-cli @dfinity/motoko recipe)
.mops/

# icp-cli state: commit the stable mainnet ID mappings (.icp/data/mappings/production.ids.json),
# ignore the build cache + per-replica local IDs.
.icp/cache/
.icp/data/mappings/local.ids.json

# Scratch / task-todo notes for AI agents & humans. Deliberately local-only:
# they capture in-flight plans and findings, not repo state.
TMP-*

# claude code — ignore .claude/ EXCEPT this project's own skill(s). git can't re-include a path
# under an excluded dir, so each parent is un-excluded step by step. The ic-* skills are installed
# from dfinity/icskills and deliberately NOT committed (a committed copy drifts from upstream).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/icgpt-local-e2e/
